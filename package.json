    "@react-navigation/native-stack": "^7.3.26",
    "expo": "~57.0.8",
    "expo-audio": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.16.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
